# http -> htpps
# <IfModule mod_headers.c>
#     Header set Content-Security-Policy "upgrade-insecure-requests"
# </IfModule>

<IfModule mod_headers.c>
    #Standard Security Headers
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"

    #(CSP)
    Header set Content-Security-Policy "default-src 'self'; img-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none';"
</IfModule>


# Security: Protect Sensitive Files
<FilesMatch "\.(env|sql|ini|log)$">
    # Modern Apache 2.4 syntax
    Require all denied
</FilesMatch>

# Also block access to the .htaccess file itself
<Files .htaccess>
    Require all denied
</Files>

#Enable GZIP (The "Compressor")
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript
</IfModule>

#cache
<IfModule mod_expires.c>
    ExpiresActive On
    # Set cache expiration for image/webp files to 1 month
    ExpiresByType image/webp "access plus 1 month"
    # Set cache expiration for text/css files to 1 week
    ExpiresByType text/css "access plus 1 week"
</IfModule>


# URL Rewriting (Clean URLs)
RewriteEngine On

# Ensure images, CSS, and JS files load normally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite /post/my-title to post.php?slug=my-title
RewriteRule ^post/([a-zA-Z0-9-]+)/?$ post.php?slug=$1 [L,QSA]

# Route /admin/... to admin.php
RewriteRule ^admin(/.*)?$ admin.php [QSA,L]

#sitemap php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

